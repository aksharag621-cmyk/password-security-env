from fastapi import FastAPI

app = FastAPI()

TASKS = [
    {"id": 1, "task": "Check password strength"}
]

@app.get("/")
def root():
    return {"message": "API running"}

@app.get("/tasks")
def get_tasks():
    return {"tasks": TASKS}

@app.post("/reset")
def reset():
    return {
        "observation": {
            "tasks": TASKS
        }
    }

@app.post("/step")
def step(action: dict):
    return {
        "observation": {"message": "step done"},
        "reward": 0,
        "done": False
    }

@app.post("/grader")
def grader():
    return {"score": 1.0}
